{
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	// Shared weekly policy and the Sora runner live in ardzero/sora-renovate.
	// See .github/RENOVATE.md.
	extends: ["github>ardzero/sora-renovate:weekly"],

	packageRules: [
		{
			description: "Astro major: core and official integrations move together, never automerge; the label triggers a notification (.github/workflows/renovate-notify.yml)",
			matchPackageNames: ["astro", "@astrojs/**"],
			matchUpdateTypes: ["major"],
			groupName: "astro major",
			groupSlug: "astro-major",
			automerge: false,
			addLabels: ["astro-major"],
			assignees: ["ardzero"],
			prBodyNotes: [
				"⚠️ **Astro major update** — not auto-merged. Read the upgrade guide before merging: https://docs.astro.build/en/guides/upgrade-to/",
			],
		},
		{
			description: "Wrapper's create-bunestro dependency is synced by the publish workflow",
			matchFileNames: ["packages/bunestro-wrapper/**"],
			enabled: false,
		},
	],
}
